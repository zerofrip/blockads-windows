<Window x:Class="BlockAds.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockAds"
        Width="520" Height="560"
        MinWidth="420" MinHeight="480"
        Background="#F3F3F3">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="BlockAds" FontSize="28" FontWeight="SemiBold"
                 AutomationProperties.Name="BlockAds"/>
      <TextBlock Text="{Binding ProtectionDisplay, StringFormat=Protection: {0}}"
                 FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4"
                 AutomationProperties.Name="Protection state"
                 AutomationProperties.LiveSetting="Assertive"/>
      <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" Margin="0,0,0,12"
                 AutomationProperties.Name="Protection guidance"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="Enable" Command="{Binding EnableCommand}" MinWidth="100" Margin="0,0,8,0"
                Padding="12,6" AutomationProperties.Name="Enable protection"/>
        <Button Content="Disable" Command="{Binding DisableCommand}" MinWidth="100" Margin="0,0,8,0"
                Padding="12,6" AutomationProperties.Name="Disable protection"/>
        <Button Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="100"
                Padding="12,6" AutomationProperties.Name="Refresh status"/>
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock Text="{Binding LastError}" Foreground="#8B0000" TextWrapping="Wrap"
                 AutomationProperties.Name="Last error"/>
      <Button Content="Reload filters" Command="{Binding ReloadFiltersCommand}"
              HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6"
              AutomationProperties.Name="Reload filters"/>
      <TextBlock Text="Closing this window hides to tray. Exit UI from the tray menu leaves protection running."
                 Margin="0,12,0,0" FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Background="White" Padding="16" CornerRadius="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Service" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServiceState}"
                   AutomationProperties.Name="Service status"/>

        <TextBlock Grid.Row="1" Text="Desired" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DesiredProtection}" Margin="0,8,0,0"
                   AutomationProperties.Name="Desired protection"/>

        <TextBlock Grid.Row="2" Text="Runtime" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeProtection}" Margin="0,8,0,0"
                   AutomationProperties.Name="Runtime protection"/>

        <TextBlock Grid.Row="3" Text="Listener" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ListenerHealth}" Margin="0,8,0,0"
                   AutomationProperties.Name="Listener health"/>

        <TextBlock Grid.Row="4" Text="DNS ownership" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DnsOwnership}" Margin="0,8,0,0"
                   AutomationProperties.Name="DNS ownership"/>

        <TextBlock Grid.Row="5" Text="Recovery" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RecoveryState}" Margin="0,8,0,0"
                   AutomationProperties.Name="Recovery state"/>

        <TextBlock Grid.Row="6" Text="Filters" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FilterStatus}" Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="Filter status"/>

        <TextBlock Grid.Row="7" Text="Last health failure" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastHealthFailure}" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="8" Text="Last restore error" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LastRestoreError}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
