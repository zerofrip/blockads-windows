+// Startup runs ownership-safe Recover, then applies desired protection state.
+//
+// Policy:
+//   - Recover never blindly restores DNS that was externally changed.
+//   - config.Enabled is the persisted desired protection flag (service running
+//     ≠ filtering). After Recover, if Enabled is true, Enable is invoked so
+//     planned reboot (and SCM restart) restores protection intentionally.
+func (c *Controller) Startup(ctx context.Context) error {
+	_, recErr := c.Recover(ctx)
+	c.mu.Lock()
+	want := c.appConfig.Enabled
+	c.mu.Unlock()
+	if !want {
+		return recErr
+	}
+	if err := c.Enable(ctx); err != nil {
+		if recErr != nil {
+			return fmt.Errorf("recover: %v; enable desired: %w", recErr, err)
+		}
+		return err
+	}
+	return nil
+}
